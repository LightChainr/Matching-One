    "P4": "(first_orientation-second_orientation)/(cos4_first-cos4_second)"
  },
  "raw_comparator": {
    "observer": "O_ext",
    "source": "J_D-beta_raw*J_S",
    "beta_raw": "Re E[J_D*conj(J_S)]/E[|J_S|^2]",
    "response": "connected Cov(O_ext,J_D-beta_raw*J_S)",
    "retained_fraction": "abs(P4_clock_response)/abs(P4_raw_response)"
  },
