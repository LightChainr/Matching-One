{
  "schema": "matching-one/main-ruleset-contract/v1",
  "issue": 52,
  "status": "desired_local_contract_only",
  "target_branch": "main",
  "workflow_path": ".github/workflows/ci.yml",
  "workflow_name": "ci",
  "required_status_checks": [
    "Python 3.9",
    "Python 3.11",
    "Python 3.13",
    "C++17 build and self-tests"
