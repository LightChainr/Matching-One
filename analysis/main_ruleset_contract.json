  "desired_policy": {
    "require_pull_request": true,
    "required_approving_review_count": 0,
    "block_force_pushes": true,
    "block_deletions": true,
    "require_linear_history": false,
    "require_external_approvals": false
  },
  "hosting_side_state": "not_checked_or_modified",
  "claim_boundary": {
    "conclusion": "The desired main policy and exact CI check names are synchronized with the checked-in workflow.",
