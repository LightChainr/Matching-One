@article{MertensZiff2016Matching,
  author = {Mertens, Stephan and Ziff, Robert M.},
  title = {Percolation in finite matching lattices},
  journal = {Physical Review E},
  volume = {94},
  number = {6},
  pages = {062152},
  year = {2016},
  doi = {10.1103/PhysRevE.94.062152},
  eprint = {1603.07289},
  archivePrefix = {arXiv},
  primaryClass = {cond-mat.stat-mech},
  note = {Primary text read 2026-09-08 via arXiv (LightChainr/Matching-One#642). Finite-size
          Sykes--Essam identity, eq. (4)/(20): M_L(p) = R^x_L(p) - Rhat^x_L(1-p) exactly for all
          L and p; matching function D(C) in {+1,0,-1} per configuration; M_L(p_c) = 0 for all L
          for self-matching/self-dual pairs; root p*_L - p_c ~ L^{-w} empirical w ~ 4, faster than
          wrapping-estimator L^{-11/4}. Quotes: notes/torus-wrapping-retrieval-20260908.md}
}

